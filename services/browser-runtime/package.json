{
  "name": "@trigix/browser-runtime",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run tests/artifact-manager.test.ts tests/config.test.ts tests/semaphore.test.ts tests/url-policy.test.ts",
    "test:coverage": "vitest run --coverage tests/artifact-manager.test.ts tests/config.test.ts tests/semaphore.test.ts tests/url-policy.test.ts",
    "test:e2e": "vitest run tests/runtime.e2e.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "fastify": "^5.6.0",
    "ipaddr.js": "^2.2.0",
    "playwright": "1.55.1",
    "prom-client": "^15.1.3",
    "redis": "^5.8.2",
    "ulid": "^3.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
