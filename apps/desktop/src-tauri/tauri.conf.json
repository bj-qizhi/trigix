{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trigix Desktop",
  "version": "1.5.1",
  "identifier": "com.trigix.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Trigix Desktop",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["main-shell"],
      "freezePrototype": true,
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://api.openai.com; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/desktop-automation-host"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
